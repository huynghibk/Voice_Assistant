<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat/Material required by MediaRouter; plain android.Theme crashes on start. -->
    <style name="Theme.VoiceAssistant" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Transparent host for ACTION_PROCESS_TEXT bottom sheet -->
    <style name="Theme.VoiceAssistant.Translucent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
